          { "title": "Vanhat mallit (esim. S-sarja)", "enum": ["old"] },
          { "title": "Uudet mallit - Eurooppa (X & V -sarjat)", "enum": ["new_eu"] },
          { "title": "Uudet mallit - USA", "enum": ["new_us"] }
        ]
