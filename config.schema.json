{
  "pluginAlias": "SunseekerLawnmower",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "required": ["name", "email", "password"],
    "properties": {
      "name": {
        "title": "Nimi",
        "type": "string",
        "default": "Sunseeker Lawnmower",
        "description": "Nimi, jolla plugin näkyy Homebridgessä."
      },
      "email": {
        "title": "Sähköpostiosoite",
        "type": "string",
        "format": "email",
        "description": "Robotic Mower Connect -tilisi sähköpostiosoite."
      },
      "password": {
        "title": "Salasana",
        "type": "string",
        "format": "password",
        "description": "Robotic Mower Connect -tilisi salasana."
      },
      "language": {
        "title": "Language / Kieli",
        "type": "string",
        "default": "fi",
        "description": "Pluginin käyttämä kieli palveluiden nimissä, lokeissa ja pilvikutsujen Accept-Language-headerissa.",
        "oneOf": [
          { "title": "Suomi", "enum": ["fi"] },
          { "title": "English", "enum": ["en"] }
        ]
      },
      "pollInterval": {
        "title": "Päivitysväli sekunteina",
        "type": "integer",
        "default": 60,
        "minimum": 15,
        "description": "Kuinka usein leikkurin tila haetaan pilvestä."
      },
      "offCommand": {
        "title": "Mower-kytkimen OFF-toiminto",
        "type": "string",
        "default": "pause",
        "description": "Mitä tehdään, kun HomeKitin Mower-kytkin laitetaan pois päältä.",
        "oneOf": [
          { "title": "Pause", "enum": ["pause"] },
          { "title": "Return Home", "enum": ["home"] }
        ]
      },
      "enableHistory": {
        "title": "Eve-historia käyttöön",
        "type": "boolean",
        "default": true,
        "description": "Tallentaa leikkuuhistoriaa Eve-sovellusta varten fakegato-historyllä."
      },
      "historySize": {
        "title": "Eve-historian koko",
        "type": "integer",
        "default": 4032,
        "minimum": 288,
        "maximum": 10000,
        "description": "Kuinka monta historiatapahtumaa säilytetään."
      }
    }
  }
}